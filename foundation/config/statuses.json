  "rules": [
    {
      "id": "delivery_only_for_in_transit",
      "description": "deliveryStatuses apply only when ownershipStatus is in_transit."
    },
    {
      "id": "delivery_received_action",
      "description": "When user marks delivery as received, ownershipStatus changes from in_transit to owned."
    },
    {
      "id": "delivery_due_statuses_are_computed",
      "description": "deliveryDueStatuses are calculated from expectedDeliveryDate and are not selected manually."
    },
    {
      "id": "loan_only_for_borrowed_or_lent",
      "description": "loanStatuses and loanDueStatuses apply only when ownershipStatus is borrowed_from_someone or lent_to_someone."
    },
    {
      "id": "loan_due_statuses_are_computed",
      "description": "loanDueStatuses are calculated from returnDueDate and returnedAt."
    },
    {
      "id": "spoiler_is_content_flag",
      "description": "Spoiler is a content flag for notes, quotes, characters or descriptions. It is not a book status."
    },
    {
      "id": "favorite_is_boolean",
      "description": "Favorite is stored as isFavorite boolean and is not a status."
    }
  ]
